@page "/"
@inject SystemHealthApiClient HealthApi

<PageTitle>Farm FMS</PageTitle>

<div class="container-fluid">
    <h1 class="mb-3">Farm FMS</h1>

    <RadzenCard class="mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="m-0">Backend API</RadzenText>
            @if (_apiHealthy is null)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Checking..." />
            }
            else if (_apiHealthy.Value)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Online" />
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Unreachable" />
            }
            <RadzenButton Text="Recheck" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="CheckApiAsync" />
        </RadzenStack>
    </RadzenCard>
</div>

@code {
    private bool? _apiHealthy;

    protected override async Task OnInitializedAsync() => await CheckApiAsync();

    private async Task CheckApiAsync()
    {
        _apiHealthy = null;
        _apiHealthy = await HealthApi.IsHealthyAsync();
    }
}
