{
  "ConnectionStrings": {
    "FarmFMS": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "FarmFMS.API",
    "Audience": "FarmFMS",
    "AccessTokenLifetimeMinutes": 10,
    "ClockSkewSeconds": 30,
    "SigningKey": ""
  },
  "PasswordEncryption": {
    "ActiveKeyVersion": "",
    "Keys": {}
  },
  "Session": {
    "AbsoluteLifetimeHours": 12,
    "ActivityTouchIntervalSeconds": 60
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "SystemUser": {
    "Username": "SYSTEM"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*"
}